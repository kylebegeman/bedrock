# Only a dedicated disposable Ubuntu/Debian machine. This file is trusted
# local shell configuration; do not use one received from an unknown source.
LANE_DISPOSABLE=true
LANE_ID=00000000000000000000000000000000 # replace with openssl rand -hex 16
HOST=203.0.113.10
PORT=22
KEY=/absolute/path/to/lane-key
KNOWN_HOSTS=/absolute/path/to/pinned-lane-known-hosts
LANE_DOMAIN=lane.example.com
LANE_ZONE=example.com
# Optional historical private-app proofs:
# LANE_SITE_URL=https://example.com
# LANE_BEGAMIN_REPO=/absolute/path/to/fixture-repository
# LANE_DW_CHAPTERS=1
