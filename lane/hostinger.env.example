# The Hostinger VPS the lane wipes and rebuilds, and the names the proofs
# use. Copy this to hostinger.env (ignored by git) and fill in your own.
# Point it only at a machine you can lose: reset.sh reinstalls the OS on it.
VM_ID=0
TEMPLATE_ID=0
SCRIPT_ID=0
KEY_ID=0
HOST=203.0.113.10
KEY=${BEDROCK_LANE_KEY:-$HOME/.ssh/lane-deploy}

# The Cloudflare zone, and the domain under it whose wildcard record
# (*.LANE_DOMAIN) points at HOST. Fixtures are rewritten to it on the box.
LANE_ZONE=example.com
LANE_DOMAIN=lane.example.com

# What the private-app proofs (prove-m4.sh to prove-m6.sh) need: the site
# begamin links to, its repository on this machine, how many chapters the
# Dragon Writer dump holds, and optionally one upload path to fetch.
LANE_SITE_URL=https://example.com
LANE_BEGAMIN_REPO=$HOME/src/begamin
LANE_DW_CHAPTERS=0
# LANE_DW_DRAWING=/uploads/gallery/example.png
